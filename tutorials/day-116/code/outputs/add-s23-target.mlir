  llvm.store %s12, %s12_dst_p : f32, !llvm.ptr
  llvm.return %c : !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)>
}

// 运行库符号：真实 MLIR 由 MemRefToLLVM 自动声明 malloc
llvm.func @malloc(i64) -> !llvm.ptr
