===== 阶段 3: 折叠后 IR（7 个 mini.*）=====
module {
  func.func @exercise(%arg0: tensor<2x3xf32>, %arg1: tensor<3x2xf32>, %arg2: tensor<2x2xf32>) -> (tensor<2x2xf32>, tensor<2x2xf32>) {
    %0 = mini.constant dense<0.000000e+00> : tensor<2x2xf32>
    %1 = mini.constant dense<1.000000e+00> : tensor<2x2xf32>
    %2 = mini.matmul %arg0, %arg1 : tensor<2x3xf32>, tensor<3x2xf32> -> tensor<2x2xf32>
    %3 = mini.add %2, %1 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %4 = mini.relu %3 : tensor<2x2xf32>
    %5 = mini.add %arg2, %0 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %6 = mini.relu %5 : tensor<2x2xf32>
    return %4, %6 : tensor<2x2xf32>, tensor<2x2xf32>
  }
}

