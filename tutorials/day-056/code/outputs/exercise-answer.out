===== 阶段 4: 融合后 IR（4 个 mini.*）=====
module {
  func.func @exercise(%arg0: tensor<2x3xf32>, %arg1: tensor<3x2xf32>, %arg2: tensor<2x2xf32>) -> (tensor<2x2xf32>, tensor<2x2xf32>) {
    %0 = mini.constant dense<0.000000e+00> : tensor<2x2xf32>
    %1 = mini.constant dense<1.000000e+00> : tensor<2x2xf32>
    %2 = mini.fused_matmul_bias_relu %arg0, %arg1, %1 : tensor<2x3xf32>, tensor<3x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %3 = mini.fused_add_relu %arg2, %0 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    return %2, %3 : tensor<2x2xf32>, tensor<2x2xf32>
  }
}

