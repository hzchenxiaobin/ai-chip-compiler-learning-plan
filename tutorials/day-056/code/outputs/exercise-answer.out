===== 阶段 0: 输入 IR（9 个 mini.*）=====
module {
  func.func @exercise(%arg0: tensor<2x3xf32>, %arg1: tensor<3x2xf32>, %arg2: tensor<2x2xf32>) -> (tensor<?x2xf32>, tensor<2x2xf32>) {
    %0 = mini.constant dense<5.000000e-01> : tensor<2x2xf32>
    %1 = mini.constant dense<5.000000e-01> : tensor<2x2xf32>
    %2 = mini.add %0, %1 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %3 = mini.matmul %arg0, %arg1 : tensor<2x3xf32>, tensor<3x2xf32> -> tensor<?x2xf32>
    %4 = mini.add %3, %2 : tensor<?x2xf32>, tensor<2x2xf32> -> tensor<?x2xf32>
    %5 = mini.relu %4 : tensor<?x2xf32>
    %6 = mini.constant dense<0.000000e+00> : tensor<2x2xf32>
    %7 = mini.add %arg2, %6 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %8 = mini.relu %7 : tensor<2x2xf32>
    return %5, %8 : tensor<?x2xf32>, tensor<2x2xf32>
  }
}

