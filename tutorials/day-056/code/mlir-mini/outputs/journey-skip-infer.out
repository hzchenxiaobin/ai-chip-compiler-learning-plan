===== 阶段 0: 输入 IR（8 个 mini.*）=====
module {
  func.func @journey(%arg0: tensor<2x3xf32>, %arg1: tensor<3x2xf32>, %arg2: tensor<2x2xf32>, %arg3: tensor<2x2xf32>) -> (tensor<?x2xf32>, tensor<2x2xf32>) {
    %0 = mini.constant dense<5.000000e-01> : tensor<2x2xf32>
    %1 = mini.constant dense<5.000000e-01> : tensor<2x2xf32>
    %2 = mini.add %0, %1 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %3 = mini.matmul %arg0, %arg1 : tensor<2x3xf32>, tensor<3x2xf32> -> tensor<?x2xf32>
    %4 = mini.add %3, %2 : tensor<?x2xf32>, tensor<2x2xf32> -> tensor<?x2xf32>
    %5 = mini.relu %4 : tensor<?x2xf32>
    %6 = mini.add %arg2, %arg3 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %7 = mini.relu %6 : tensor<2x2xf32>
    return %5, %7 : tensor<?x2xf32>, tensor<2x2xf32>
  }
}

