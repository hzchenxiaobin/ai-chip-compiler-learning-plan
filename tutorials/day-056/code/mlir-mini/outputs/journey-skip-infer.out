===== 阶段 3: 折叠后 IR（6 个 mini.*）=====
module {
  func.func @journey(%arg0: tensor<2x3xf32>, %arg1: tensor<3x2xf32>, %arg2: tensor<2x2xf32>, %arg3: tensor<2x2xf32>) -> (tensor<?x2xf32>, tensor<2x2xf32>) {
    %0 = mini.constant dense<1.000000e+00> : tensor<2x2xf32>
    %1 = mini.matmul %arg0, %arg1 : tensor<2x3xf32>, tensor<3x2xf32> -> tensor<?x2xf32>
    %2 = mini.add %1, %0 : tensor<?x2xf32>, tensor<2x2xf32> -> tensor<?x2xf32>
    %3 = mini.relu %2 : tensor<?x2xf32>
    %4 = mini.add %arg2, %arg3 : tensor<2x2xf32>, tensor<2x2xf32> -> tensor<2x2xf32>
    %5 = mini.relu %4 : tensor<2x2xf32>
    return %3, %5 : tensor<?x2xf32>, tensor<2x2xf32>
  }
}

