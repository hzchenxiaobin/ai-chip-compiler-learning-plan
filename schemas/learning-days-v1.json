{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learning-days-v1.json",
  "title": "AI 芯片编译器学习网站 days.json 契约（WP-01）",
  "type": "object",
  "required": ["schema_version", "content_commit", "generated_at", "base_path", "days"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "content_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "base_path": { "type": "string", "pattern": "^$|^/[^/].*[^/]$" },
    "days": {
      "type": "array",
      "minItems": 168,
      "maxItems": 168,
      "items": { "$ref": "#/definitions/day" }
    }
  },
  "definitions": {
    "day": {
      "type": "object",
      "required": [
        "day_id", "day", "week", "phase", "type", "key_output", "title",
        "objective", "time", "prerequisites", "deliverable", "source_path",
        "code_path", "url", "source_zip", "code_url", "outputs_url",
        "run_all", "skills", "required_tasks", "content_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "day_id": { "type": "string", "pattern": "^day-[0-9]{3}$" },
        "day": { "type": "integer", "minimum": 1, "maximum": 168 },
        "week": { "type": "integer", "minimum": 1, "maximum": 24 },
        "phase": { "type": "integer", "minimum": 1, "maximum": 6 },
        "type": {
          "type": "string",
          "enum": ["concept_lab", "environment_lab", "integration", "review", "documentation", "presentation", "final_assessment"]
        },
        "key_output": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "time": {
          "type": "object",
          "required": ["learning_min", "practice_min"],
          "additionalProperties": false,
          "properties": {
            "learning_min": { "type": "integer", "minimum": 1 },
            "practice_min": { "type": "integer", "minimum": 1 }
          }
        },
        "prerequisites": { "type": "string", "minLength": 1 },
        "deliverable": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "pattern": "^tutorials/week-[0-9]{3}/day-[0-9]{3}/README\\.md$" },
        "code_path": {
          "oneOf": [
            { "type": "string", "pattern": "^tutorials/week-[0-9]{3}/day-[0-9]{3}/code$" },
            { "type": "null" }
          ]
        },
        "url": { "type": "string", "pattern": "^tutorials/week-[0-9]{3}/day-[0-9]{3}/$" },
        "source_zip": {
          "oneOf": [
            { "type": "string", "pattern": "^downloads/day-[0-9]{3}-source\\.zip$" },
            { "type": "null" }
          ]
        },
        "code_url": { "type": ["string", "null"] },
        "outputs_url": { "type": ["string", "null"] },
        "run_all": { "type": "boolean" },
        "skills": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "required_tasks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "type": "string", "enum": ["reading", "exercise", "experiment", "acceptance"] }
        },
        "content_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
