{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learning-progress-v1.json",
  "title": "本地学习进度导出/导入契约（WP-06）",
  "type": "object",
  "required": ["schema_version", "kind", "exported_at", "content_commit", "days"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ai-chip-compiler-learning-progress" },
    "exported_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "content_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "days": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/definitions/dayProgress" }
    }
  },
  "definitions": {
    "dayProgress": {
      "type": "object",
      "required": [
        "schema_version", "day_id", "content_sha", "planned", "tasks",
        "latest_evidence_id", "stuck_item_ids", "last_visited_at",
        "needs_review", "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "day_id": { "type": "string", "pattern": "^day-[0-9]{3}$" },
        "content_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "planned": { "type": "boolean" },
        "tasks": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 4,
          "additionalProperties": { "$ref": "#/definitions/taskStatus" },
          "propertyNames": { "enum": ["reading", "exercise", "experiment", "acceptance"] }
        },
        "latest_evidence_id": { "type": ["string", "null"] },
        "stuck_item_ids": { "type": "array", "items": { "type": "string" } },
        "last_visited_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "needs_review": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "taskStatus": {
      "type": "object",
      "required": ["status", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "done", "blocked", "not_applicable"]
        },
        "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
      }
    }
  }
}
